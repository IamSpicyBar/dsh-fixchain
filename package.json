{
  "name": "dsh-fixchain",
  "version": "0.3.0-studio.1",
  "description": "Repair-chain attribution for DeepSeek Harness migrations: /fixchain views dsh Session trajectories in the inquiry UI, prepares a dsh migration + repair for card making, and runs the card session inside dsh",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./offline": "./lib/offline.js",
    "./package.json": "./package.json",
    "./capabilities": "./capabilities.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "capabilities.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "migration",
    "attribution",
    "memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IamSpicyBar/dsh-fixchain.git"
  }
}
